   "source": [
    "# Montagem final, Correlação candidatos Douglas e Renata por região imediata / intermediária e Plotagem\n",
    "import pandas as pd\n",
    "import geopandas as gpd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "for col in [\"votos_renata\", \"votos_douglas\", \"total_votos\"]:\n",
    "    if col not in gdf.columns:\n",
    "        raise KeyError(f\"Coluna esperada não encontrada no gdf: {col}\")\n",
    "\n",
    "gdf[\"regiao-imediata-nome\"] = gdf[\"regiao-imediata-nome\"].astype(str).str.strip()\n",
    "gdf[\"regiao-intermediaria-nome\"] = gdf[\"regiao-intermediaria-nome\"].astype(str).str.strip()\n",
    "\n",
    "num_cols = [\"votos_renata\", \"votos_douglas\", \"total_votos\"]\n",
    "for c in num_cols:\n",
    "    gdf[c] = (gdf[c]\n",
    "              .astype(str)                         \n",
    "              .str.replace(r'[^\\d]', '', regex=True)  \n",
    "             )\n",
    "    # Convert to numeric safely\n",
    "    gdf[c] = pd.to_numeric(gdf[c], errors=\"coerce\").fillna(0).astype(np.int64)\n",
    "\n",
    "cols_to_keep = [\"regiao-imediata-nome\", \"regiao-intermediaria-nome\"] + num_cols + [\"geometry\"]\n",
    "gdf_clean = gdf[cols_to_keep].copy()\n",
    "\n",
    "gdf_clean = gdf_clean.set_geometry(\"geometry\")\n",
    "gdf_clean = gdf_clean[~gdf_clean.geometry.is_empty & gdf_clean.geometry.notnull()]\n",
    "\n",
    "gdf_imediata = gdf_clean.dissolve(by=\"regiao-imediata-nome\", aggfunc=\"sum\")\n",
    "gdf_intermediaria = gdf_clean.dissolve(by=\"regiao-intermediaria-nome\", aggfunc=\"sum\")\n",
    "\n",
    "for g in [gdf_imediata, gdf_intermediaria]:\n",
    "    g[\"pct_renata\"] = np.where(g[\"total_votos\"] > 0,\n",
    "                               100 * g[\"votos_renata\"] / g[\"total_votos\"],\n",
    "                               0.0)\n",
    "    g[\"pct_douglas\"] = np.where(g[\"total_votos\"] > 0,\n",
    "                                100 * g[\"votos_douglas\"] / g[\"total_votos\"],\n",
    "                                0.0)\n",
    "\n",
    "for dfg in [gdf_imediata, gdf_intermediaria]:\n",
